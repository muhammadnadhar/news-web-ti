FROM node:26-alpine AS builder

WORKDIR /app

# Copy package.json dan install semua dependencies
COPY package*.json ./
RUN npm ci

# Copy seluruh source code dan lakukan build
COPY . .
RUN npm run build

FROM node:26-alpine AS runner

WORKDIR /app

# Copy hasil build dan package.json untuk production
COPY --from=builder /app/build ./build
COPY --from=builder /app/package*.json ./

# Install hanya dependencies production agar ukuran image tetap kecil
RUN npm ci --omit=dev

# Jalankan SvelteKit (default adapter-node berjalan di port 3000)
EXPOSE 3000
CMD ["node", "build"]
